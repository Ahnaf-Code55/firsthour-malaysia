{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true,
    "types": ["vite/client", "node"], "isolatedModules": true
  },
  "include": ["src", "tests", "server", "data", "vite.config.ts"]
}
